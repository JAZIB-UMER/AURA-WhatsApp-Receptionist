# AURA settings. Copy this file to .env, fill it in, and keep it PRIVATE (never commit it).
#
# Accounts (API keys, email) below are imported ONCE, on the first start with an empty database.
# After that, change them in the dashboard (Admin -> Platform settings). Each business's WhatsApp
# instance, calendar and owner contacts are set on that business in the dashboard.
# Google service-account key: put the .json file at secrets/credentials.json (also imported once).

# First admin login (username "admin"). After logging in, set your own password in
# Platform settings; this value is then ignored. Forgot it later?
#   docker compose exec aura python -m app.services.config reset-admin
ADMIN_PASSWORD=change-me-123

# ---- Your accounts (optional here; can also be entered in the dashboard) -----------------------
# GEMINI_API_KEY=            aistudio.google.com -> Get API key
# GROQ_API_KEY=              console.groq.com -> API Keys (voice notes)
# WAAPI_TOKEN=               waapi.app -> User API Tokens
# SMTP_HOST=smtp.gmail.com   email alerts to owners (Gmail: an App Password, not the normal password)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Docker (docker compose up) ---------------------------------------------------------------
# Ports on this computer: dashboard http://localhost:8501, WhatsApp server http://localhost:8000
DASHBOARD_PORT=8501
AURA_PORT=8000
# Image to run: aura:latest (built or loaded here) or a registry name, e.g. ghcr.io/<user>/aura:1.0
AURA_IMAGE=aura:latest
# Public address for WhatsApp through a free Cloudflare tunnel (Docker: on by default; "off" to disable).
# Without Docker: set to cloudflare and install cloudflared (winget install --id Cloudflare.cloudflared).
# PUBLIC_TUNNEL=cloudflare

# ---- Running without Docker only (Docker sets these itself) ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
AURA_DB=storage/aura.db
INTENT_MODEL_DIR=models/intent_model_v2_fp16
ENTITY_MODEL_DIR=models/entity_model_fp16

# Model precision: float16 (default; half the model size, same answers on every test set) or float32.
# MODEL_DTYPE=float16
